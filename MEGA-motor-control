#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>
#include <SPI.h>
#include <SoftwareSerial.h>

#define TFT_CS   7
#define TFT_DC   5
#define TFT_RST  6
Adafruit_ILI9341 tft(TFT_CS, TFT_DC, TFT_RST);

SoftwareSerial BT(10, 11);   // Mega RX=10 (HC-05 TX), TX=11 (HC-05 RX)
#define BT_STATE 12

#define BTN_ORIGIN 30
#define BTN_UP     31
#define BTN_DOWN   33

int lastBt = -1;
int lastUp = -1, lastDown = -1, lastOrigin = -1;

const int X0 = 20;

void drawStatic() {
  tft.fillScreen(ILI9341_BLACK);
  tft.setRotation(4);
  tft.setTextSize(2);
  tft.setTextColor(ILI9341_WHITE);

  tft.setCursor(X0, 10);  tft.print("Hold-to-Move Servo");
  tft.setCursor(X0, 50);  tft.print("UP   (31):");
  tft.setCursor(X0, 80);  tft.print("DOWN (33):");
  tft.setCursor(X0,110);  tft.print("ORIG (30):");
  tft.setCursor(X0,150);  tft.print("BT:");
  tft.setCursor(X0,180);  tft.print("Last:");
}

void draw01(int x, int y, int v) {
  tft.fillRect(x, y-2, 40, 20, ILI9341_BLACK);
  tft.setCursor(x, y);
  tft.setTextColor(v ? ILI9341_GREEN : ILI9341_RED);
  tft.print(v);
  tft.setTextColor(ILI9341_WHITE);
}

void drawBt(int connected) {
  tft.fillRect(80, 150-2, 220, 20, ILI9341_BLACK);
  tft.setCursor(80, 150);
  tft.setTextColor(connected ? ILI9341_GREEN : ILI9341_RED);
  tft.print(connected ? "CONNECTED" : "DISCONNECTED");
  tft.setTextColor(ILI9341_WHITE);
}

void drawLast(const char* msg) {
  tft.fillRect(80, 180-2, 240, 20, ILI9341_BLACK);
  tft.setCursor(80, 180);
  tft.setTextColor(ILI9341_YELLOW);
  tft.print(msg);
  tft.setTextColor(ILI9341_WHITE);
}

void sendLine(const char* s) {
  BT.println(s);
  Serial.print("Sent: ");
  Serial.println(s);
  drawLast(s);
}

void setup() {
  Serial.begin(9600);
  BT.begin(9600);

  pinMode(BTN_ORIGIN, INPUT_PULLUP);
  pinMode(BTN_UP, INPUT_PULLUP);
  pinMode(BTN_DOWN, INPUT_PULLUP);
  pinMode(BT_STATE, INPUT);

  pinMode(53, OUTPUT);
  digitalWrite(53, HIGH);

  tft.begin();
  drawStatic();

  lastUp = lastDown = lastOrigin = -1;
  lastBt = -1;
}

void loop() {
  int up = (digitalRead(BTN_UP) == LOW) ? 1 : 0;
  int down = (digitalRead(BTN_DOWN) == LOW) ? 1 : 0;
  int orig = (digitalRead(BTN_ORIGIN) == LOW) ? 1 : 0;

  // TFT button indicators
  if (up != lastUp)   { lastUp = up;     draw01(250, 50, up);   sendLine(up ? "U1" : "U0"); }
  if (down != lastDown){ lastDown = down; draw01(250, 80, down); sendLine(down ? "D1" : "D0"); }

  // Origin: send once on press edge
  if (orig != lastOrigin) {
    lastOrigin = orig;
    draw01(250, 110, orig);
    if (orig == 1) sendLine("O");
  }

  int btConn = (digitalRead(BT_STATE) == HIGH) ? 1 : 0;
  if (btConn != lastBt) { lastBt = btConn; drawBt(btConn); }

  delay(15);
}
